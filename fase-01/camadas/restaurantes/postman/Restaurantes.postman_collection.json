              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/forgot-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "forgot-password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nao.cadastrado@email.com\"\n}"
            },
            "description": "Resposta idêntica ao caso de e-mail existente (202) — a API não revela quais e-mails estão cadastrados."
          }
        },
        {
          "name": "Redefinir senha — token inválido (400)",
          "request": {
            "method": "POST",
