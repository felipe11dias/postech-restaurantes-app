{
  "info": {
    "name": "Restaurantes — Tech Challenge Fase 1",
    "description": "Coleção de testes da API de gestão de usuários. Fluxo recomendado (execute de cima para baixo): 1) Autenticação > Login admin salva {{adminToken}}; 2) Usuários > Cadastro válido salva {{userId}}; 3) Login do usuário criado salva {{token}}. A API aplica autorização por posse: um usuário só acessa o próprio {id}; ROLE_ADMIN acessa qualquer um.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Login admin (seed) — salva adminToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('adminToken', json.token);",
                  "  console.log('adminToken salvo.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"admin.demo\",\n  \"password\": \"admin12345\"\n}"
            }
          }
        },
        {
          "name": "Login inválido (401)",
