              "raw": "{\n  \"token\": \"token-inexistente-ou-expirado\",\n  \"newPassword\": \"senhaNova456\",\n  \"confirmPassword\": \"senhaNova456\"\n}"
            }
          }
        },
        {
          "name": "Redefinir senha — senhas não coincidem (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/reset-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "reset-password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"qualquer-token\",\n  \"newPassword\": \"senhaNova456\",\n  \"confirmPassword\": \"senhaDiferente789\"\n}"
            },
            "description": "A confirmação é conferida antes da validação do token, então qualquer valor de token dispara o mesmo erro 400."
          }
        },
        {
          "name": "Redefinir senha — sucesso (204)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/reset-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "reset-password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"senhaNova456\",\n  \"confirmPassword\": \"senhaNova456\"\n}"
            },
            "description": "Requer a variável de coleção {{resetToken}} preenchida com o token bruto recebido por e-mail na requisição 'Esqueci minha senha — e-mail existente'."
          }
        }
      ]
    },
