# Banco de dados
DB_NAME=restaurantes-hex
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# JWT
JWT_SECRET=troque-este-segredo-por-um-valor-grande-de-no-minimo-256-bits
JWT_EXPIRATION=3600000

# E-mail (recuperação de senha) — defaults apontam para um SMTP local de testes
# (ex.: `python -m smtpd -c DebuggingServer -n localhost:1025`). Para um provedor
# real (Gmail, Mailtrap etc.), troque host/porta/usuário/senha e habilite auth/starttls.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@restaurantes.postech
MAIL_RESET_TOKEN_EXPIRATION_MINUTES=30
