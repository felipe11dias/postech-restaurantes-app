                  "pm.test('traz metadados de paginação', () => {",
                  "  pm.expect(pm.response.json().page).to.have.property('totalElements');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/users?name=Joana&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [
                { "key": "name", "value": "Joana" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
