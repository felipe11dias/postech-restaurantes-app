            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Outra Pessoa\",\n  \"email\": \"JOANA@email.com\",\n  \"login\": \"outra.pessoa\",\n  \"password\": \"senha12345\",\n  \"roles\": [\"ROLE_CUSTOMER\"]\n}"
            }
          }
        },
