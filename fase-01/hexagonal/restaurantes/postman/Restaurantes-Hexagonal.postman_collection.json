{
  "info": {
    "name": "Restaurantes — Fase 1 (Hexagonal)",
    "description": "Tech Challenge Fase 1 — variante em Arquitetura Hexagonal (Ports & Adapters).\n\nOrdem sugerida: Autenticação > Login (salva o token) e depois os demais.\n\nVariáveis: baseUrl, token, userId, adminToken, resetToken.\n\nO token de redefinição de senha nunca é retornado pela API. Recupere-o do log:\n  docker logs restaurantes-hex-app | grep \"Token de redefinição\"\ne cole em {{resetToken}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "token", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "resetToken", "value": "" }
  ],
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Login válido (dono) — 200, salva token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('devolve token Bearer', () => {",
                  "  pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.type).to.eql('Bearer');",
                  "});",
                  "pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"dono.restaurante\",\n  \"password\": \"dono12345\"\n}"
            }
          }
        },
        {
          "name": "Login admin — 200, salva adminToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"admin.demo\",\n  \"password\": \"admin12345\"\n}"
            }
          }
        },
        {
          "name": "Login com senha errada — 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('mensagem não revela se o login existe', () => {",
                  "  pm.expect(pm.response.json().detail).to.eql('Login ou senha inválidos');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"dono.restaurante\",\n  \"password\": \"senha-errada\"\n}"
            }
          }
        },
        {
          "name": "Login inexistente — 401 idêntico",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('resposta idêntica à de senha errada', () => {",
                  "  pm.expect(pm.response.json().detail).to.eql('Login ou senha inválidos');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"nao.existe\",\n  \"password\": \"qualquer123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Cadastro",
      "item": [
        {
          "name": "Cadastro válido — 201, salva userId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('e-mail normalizado para minúsculas', () => {",
                  "  pm.expect(body.email).to.eql('joana@email.com');",
                  "});",
                  "pm.test('nunca expõe senha', () => {",
                  "  pm.expect(pm.response.text()).to.not.include('password');",
                  "});",
                  "pm.test('traz links HATEOAS', () => pm.expect(body._links.self).to.exist);",
                  "pm.collectionVariables.set('userId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Joana Teste\",\n  \"email\": \"Joana@Email.COM\",\n  \"login\": \"joana.teste\",\n  \"password\": \"senha12345\",\n  \"roles\": [\"ROLE_CUSTOMER\"],\n  \"addresses\": [\n    {\n      \"street\": \"Av. Paulista\",\n      \"number\": \"1500\",\n      \"complement\": \"Apto 42\",\n      \"neighborhood\": \"Bela Vista\",\n      \"city\": \"São Paulo\",\n      \"state\": \"SP\",\n      \"zipCode\": \"01310-200\"\n    }\n  ]\n}"
